{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vixrex.com/schemas/invoice-to-product-card/1.0.0",
  "title": "Vixrex fatura fotoğrafından ürün kartına veri sözleşmeleri",
  "description": "OpenRouter'da iki ayrı preset görevi için platformdan bağımsız sözleşmeler. Vixrex iç tablo adları değildir; Vixrex bunları kendi mevcut kayıtlarına eşler.",
  "$defs": {
    "invoiceReadResult": {
      "title": "Aşama 1 — Faturayı oku",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "document",
        "items",
        "warnings"
      ],
      "properties": {
        "contract_version": {
          "const": "vixrex.invoice-read/1.0"
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_type",
            "document_number",
            "document_date",
            "supplier",
            "buyer",
            "currency",
            "totals"
          ],
          "properties": {
            "document_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "document_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "document_date": {
              "type": [
                "string",
                "null"
              ],
              "description": "Okunabiliyorsa YYYY-MM-DD; tahmin edilmez."
            },
            "supplier": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "tax_id",
                "address",
                "website_printed_on_invoice"
              ],
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tax_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "website_printed_on_invoice": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "buyer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "tax_id"
              ],
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tax_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "description": "ISO 4217 kodu; faturada yoksa null."
            },
            "totals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "goods",
                "vat",
                "discount",
                "payable"
              ],
              "properties": {
                "goods": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "vat": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "discount": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "payable": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invoice_row_number",
              "raw_text",
              "product_name",
              "brand",
              "manufacturer_printed",
              "model_or_code",
              "gtin",
              "variant_text",
              "quantity",
              "unit",
              "purchase_unit_price",
              "line_total",
              "read_confidence"
            ],
            "properties": {
              "invoice_row_number": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Faturada görünen satır numarası; yoksa null. Vixrex ayrıca deterministik row_id üretir."
              },
              "raw_text": {
                "type": "string",
                "minLength": 1,
                "description": "Faturadaki satırın özgün metni."
              },
              "product_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "brand": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Faturada görünen marka; satıcıdan/tedarikçiden çıkarım yapılmaz."
              },
              "manufacturer_printed": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Üretici faturada açıkça yazıyorsa; satıcıyla aynı olduğu varsayılmaz."
              },
              "model_or_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gtin": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Barkod metin olarak; baştaki sıfırlar korunur. Model/bayi kodu GTIN sayılmaz."
              },
              "variant_text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Faturada yazan gramaj, renk, beden, paket veya varyant."
              },
              "quantity": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "purchase_unit_price": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "line_total": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "read_confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "productCardResearchResult": {
      "title": "Aşama 2 — Resmî kaynaktan ürün kartını zenginleştir",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "items",
        "warnings"
      ],
      "properties": {
        "contract_version": {
          "const": "vixrex.product-research/1.0"
        },
        "items": {
          "type": "array",
          "description": "Girdi faturasındaki her row_id için tam bir kayıt. Satır silinmez, birleştirilmez veya yeniden numaralandırılmaz.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row_id",
              "product",
              "verification",
              "source"
            ],
            "properties": {
              "row_id": {
                "type": "string",
                "minLength": 1
              },
              "product": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "official_name",
                  "brand",
                  "manufacturer",
                  "gtin",
                  "variant",
                  "category",
                  "short_description",
                  "attributes",
                  "model_or_code"
                ],
                "properties": {
                  "official_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Yalnız resmî kaynakta görülen ürün adı; bulunamazsa null."
                  },
                  "brand": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "manufacturer": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gtin": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "variant": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Sayfadaki gramaj/beden/renk/paket; fatura varyantıyla çelişirse doğrulanmış sayılmaz."
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "short_description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Resmî sayfadan özet; kaynakta yoksa null."
                  },
                  "attributes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "value"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "model_or_code": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Üreticinin resmî sayfasında geçen model/ürün kodu; bulunamazsa null."
                  }
                }
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "matched_attributes",
                  "unmatched_attributes",
                  "note"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "verified",
                      "ambiguous",
                      "not_found",
                      "not_researched"
                    ]
                  },
                  "matched_attributes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unmatched_attributes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_type",
                  "official_domain",
                  "product_page_url",
                  "image_url",
                  "image_page_url",
                  "image_rights_status",
                  "evidence"
                ],
                "properties": {
                  "source_type": {
                    "type": "string",
                    "enum": [
                      "manufacturer_site",
                      "brand_site",
                      "verified_by_gs1",
                      "open_food_facts",
                      "third_party",
                      "none"
                    ]
                  },
                  "official_domain": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Araştırmada üretici/marka adına ait olduğu saptanan alan adı. Tek başına doğrulanmış kabul edilmez."
                  },
                  "product_page_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "image_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri",
                    "description": "Gerçek ürün görselinin doğrudan adresi; karta alınmadan erişim ayrıca sınanır."
                  },
                  "image_page_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri",
                    "description": "Görselin ilişkilendirildiği ürün sayfası."
                  },
                  "image_rights_status": {
                    "type": "string",
                    "enum": [
                      "unknown",
                      "authorized",
                      "not_authorized"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "url",
                        "kind",
                        "observation"
                      ],
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "official_product_page",
                            "official_company_identity",
                            "verified_gtin_record",
                            "candidate_database",
                            "other"
                          ]
                        },
                        "observation": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
