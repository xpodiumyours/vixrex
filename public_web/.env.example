# Public Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATION_SECRET=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
# Sahip önizleme çerezini imzalayan gizli anahtar (rastgele, en az 32 karakter).
OWNER_SESSION_SECRET=
# "Bu vitrini kirala" oran sınırlaması için IP'yi HMAC'leyen sunucu-yalnız
# gizli anahtar (rastgele, en az 32 karakter). Boşsa ham IP kullanılır —
# üretimde MUTLAKA ayarlanmalı.
RATE_LIMIT_SECRET=
# "Bu vitrini kirala" günlük/kısa-pencere IP sınırından yalnız ekip içi test
# trafiğini muaf tutan sunucu-yalnız gizli anahtar. İstek "x-vixrex-internal-
# test-secret" başlığında bu değeri taşırsa Katman 1/2 atlanır — Katman 3
# (global saatlik 100 istek) MUAF DEĞİL. Boşsa muafiyet hiç çalışmaz.
RENT_DEMO_BYPASS_SECRET=
# Vercel Cron'un /api/cron/* rotalarını çağırırken gönderdiği
# "Authorization: Bearer <CRON_SECRET>" başlığını doğrulamak için —
# Vercel projesinde bu adla bir env değişkeni varsa otomatik eklenir.
# Boşsa cron rotası fail-closed reddeder (bkz. vercel.json "crons").
CRON_SECRET=
# #257 abonelik yenileme hatırlatması için OneSignal REST API kimlikleri.
# supabase/functions/send-booking-push ile AYNI OneSignal uygulamasının
# değerleri olmalı — Supabase Edge Function secret'ları Next.js'in ortam
# değişkenlerinden ayrıdır, burada AYRICA ayarlanmalı. Boşsa cron rotası
# fail-closed reddeder.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Public web origin
NEXT_PUBLIC_SITE_URL=https://vixrex.app
NEXT_PUBLIC_APP_URL=https://app.vixrex.app
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Instagram API with Instagram Login
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://vixrex.app/api/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic
INSTAGRAM_STATE_SECRET=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_ALLOWED_ORIGINS=https://app.vixrex.app
