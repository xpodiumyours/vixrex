{
  "version": 1,
  "description": "Vixrex zengin ürün alanlarının tek kaynak sözleşmesi. Mağaza kategori adından profil tahmini yapılmaz; profil açıkça seçilir.",
  "profiles": [
    {"key":"general_product","label":"Genel ürün","itemKind":"product","fields":["brand","barcode","sku","mpn","condition"]},
    {"key":"apparel","label":"Giyim / moda","itemKind":"product","fields":["brand","barcode","sku","color","size","material","pattern","gender","age_group"]},
    {"key":"electronics","label":"Elektronik","itemKind":"product","fields":["brand","barcode","sku","mpn","model","color","storage_capacity","ram","compatibility","warranty_text"]},
    {"key":"beauty","label":"Kozmetik / bakım","itemKind":"product","fields":["brand","barcode","sku","color","net_quantity","skin_hair_type","ingredients","usage_info"]},
    {"key":"food","label":"Gıda / içecek","itemKind":"product","fields":["brand","barcode","sku","net_quantity","ingredients","allergens","origin","storage_info"]},
    {"key":"home","label":"Ev / mobilya / dekorasyon","itemKind":"product","fields":["brand","barcode","sku","material","color","dimensions","weight","package_contents","assembly_info"]},
    {"key":"auto_part","label":"Oto / yedek parça","itemKind":"product","fields":["brand","barcode","sku","mpn","model","compatibility","condition"]},
    {"key":"service","label":"Hizmet","itemKind":"service","fields":["service_type","price_type","duration_minutes","service_location","appointment_required","service_includes"]}
  ],
  "fields": {
    "brand":{"label":"Marka","type":"text","storage":"core.brand","maxLength":120},
    "barcode":{"label":"Barkod / GTIN","type":"text","storage":"core.barcode","maxLength":32},
    "sku":{"label":"Stok kodu (SKU)","type":"text","storage":"metadata.identifiers.sku","maxLength":80},
    "mpn":{"label":"Üretici parça kodu (MPN)","type":"text","storage":"metadata.identifiers.mpn","maxLength":80},
    "condition":{"label":"Ürün durumu","type":"select","storage":"metadata.attributes.condition","options":["new","used","refurbished"]},
    "model":{"label":"Model","type":"text","storage":"metadata.attributes.model","maxLength":120},
    "color":{"label":"Renk","type":"text","storage":"metadata.attributes.color","maxLength":80,"variantEligible":true},
    "size":{"label":"Beden / ölçü","type":"text","storage":"metadata.attributes.size","maxLength":80,"variantEligible":true},
    "material":{"label":"Materyal","type":"text","storage":"metadata.attributes.material","maxLength":120,"variantEligible":true},
    "pattern":{"label":"Desen","type":"text","storage":"metadata.attributes.pattern","maxLength":120,"variantEligible":true},
    "gender":{"label":"Hedef cinsiyet","type":"text","storage":"metadata.attributes.gender","maxLength":80},
    "age_group":{"label":"Yaş grubu","type":"text","storage":"metadata.attributes.age_group","maxLength":80},
    "storage_capacity":{"label":"Depolama kapasitesi","type":"text","storage":"metadata.attributes.storage_capacity","maxLength":80,"variantEligible":true},
    "ram":{"label":"RAM","type":"text","storage":"metadata.attributes.ram","maxLength":80,"variantEligible":true},
    "compatibility":{"label":"Uyumluluk","type":"text","storage":"metadata.attributes.compatibility","maxLength":240},
    "warranty_text":{"label":"Garanti bilgisi","type":"text","storage":"metadata.attributes.warranty_text","maxLength":240},
    "net_quantity":{"label":"Net miktar","type":"text","storage":"metadata.attributes.net_quantity","maxLength":80},
    "skin_hair_type":{"label":"Cilt / saç tipi","type":"text","storage":"metadata.attributes.skin_hair_type","maxLength":120},
    "ingredients":{"label":"İçindekiler","type":"textarea","storage":"metadata.attributes.ingredients","maxLength":1000},
    "usage_info":{"label":"Kullanım bilgisi","type":"textarea","storage":"metadata.attributes.usage_info","maxLength":1000},
    "allergens":{"label":"Alerjen bilgisi","type":"textarea","storage":"metadata.attributes.allergens","maxLength":1000},
    "origin":{"label":"Menşei","type":"text","storage":"metadata.attributes.origin","maxLength":120},
    "storage_info":{"label":"Saklama bilgisi","type":"textarea","storage":"metadata.attributes.storage_info","maxLength":500},
    "dimensions":{"label":"Ölçüler","type":"text","storage":"metadata.attributes.dimensions","maxLength":120},
    "weight":{"label":"Ağırlık","type":"text","storage":"metadata.attributes.weight","maxLength":80},
    "package_contents":{"label":"Paket içeriği","type":"textarea","storage":"metadata.attributes.package_contents","maxLength":1000},
    "assembly_info":{"label":"Montaj bilgisi","type":"textarea","storage":"metadata.attributes.assembly_info","maxLength":500},
    "service_type":{"label":"Hizmet türü","type":"text","storage":"metadata.service.type","maxLength":120},
    "price_type":{"label":"Fiyat türü","type":"select","storage":"metadata.service.priceType","options":["fixed","starting_from","ask"]},
    "duration_minutes":{"label":"Tahmini süre (dakika)","type":"number","storage":"metadata.service.durationMinutes","min":1,"max":10080},
    "service_location":{"label":"Hizmet yeri","type":"select","storage":"metadata.service.location","options":["business","on_site","remote"]},
    "appointment_required":{"label":"Randevu gerekli","type":"boolean","storage":"metadata.service.appointmentRequired"},
    "service_includes":{"label":"Hizmete dahil olanlar","type":"textarea","storage":"metadata.service.includes","maxLength":1000}
  }
}
