{
  "_belge": "Vixrex 46 Alan Akıllı Tamamlama Motoru Algoritması",
  "_versiyon": "1.0.0",
  "_tarih": "2026-09-02",
  "_amaç": "46 vitrin alanını minimum kullanıcı girdisiyle, yapay zeka API'si kullanmadan, web sitesi kalitesinde doldurmak.",
  "_nasıl_calisir": "10 sıralı adım, her adım birden fazla alanı doldurur. Kategori seçimi 15+ alanı otomatik doldurur. Türetilmiş alanlar mevcut girdilerden hesaplanır. Koşullu alanlar kategoriye göre açılır/kapanır.",
  "_sonuc": "10 kullanıcı girdisi ile 46 alanın 30-35'i dolu, web sitesi kalitesinde vitrin.",

  "adimlar": [
    {
      "sira": 1,
      "id": "isletme_adi_kategori",
      "soru": "İşletmenizin adını ve kategorisini yazın",
      "aciklama": "Tek satırda hem isim hem kategori gelir. Kategori eşleşmezseoptionspciones gösterilir.",
      "girdi_tipi": "metin_plus_secim",
      "yerTutucu": "Ör: Moda Saç, Kuaför",
      "ciktilar": {
        "dogrudan": [
          { "alan": "name", "kaynak": "kullanici", "donusum": "trim" }
        ],
        "analiz": [
          { "alan": "kategori", "yontem": "kategori_eslesme", "aciklama": "business_categories.json aliases sözlüğünden eşleşme. Eşleşmezseoptionspciones gösterilir." }
        ],
        "tetiklenenler": ["kategori_kural_paketi", "apply_category_template"]
      }
    },
    {
      "sira": 2,
      "id": "whatsapp",
      "soru": "WhatsApp numaranızı girin",
      "aciklama": "Müşterilerinizin sizi ulaşacağı numara.",
      "girdi_tipi": "telefon",
      "yerTutucu": "05xx xxx xx xx",
      "ciktilar": {
        "dogrudan": [
          { "alan": "whatsapp", "kaynak": "kullanici", "donusum": "tr_mobil_format" }
        ],
        "tetiklenenler": ["whatsapp_kontrol"]
      }
    },
    {
      "sira": 3,
      "id": "adres_konum",
      "soru": "Açık adresinizi yazın",
      "aciklama": "Sokak/cadde, ilçe ve il bilgisi tek cümlede. Regex ile 5 alan ayrıştırılır.",
      "girdi_tipi": "uzunMetin",
      "yerTutucu": "Ör: Bahariye Cad. No:15, Kadıköy, İstanbul",
      "ciktilar": {
        "dogrudan": [
          { "alan": "address", "kaynak": "kullanici", "donusum": "trim" }
        ],
        "analiz": [
          { "alan": "province_name", "yontem": "turkey_cities_eslesme", "aciklama": "turkeyCities.ts/turkey_cities_config.dart sözlüğünden il eşleşmesi" },
          { "alan": "district_name", "yontem": "ilce_eslesme", "aciklama": "province_name bilindikten sonra ilçe sözlüğünden eşleşme" },
          { "alan": "hero_location_text", "yontem": "turulmus", "formul": "{district_name}, {province_name}", "aciklama": "İlçe + il birleştirilir" },
          { "alan": "map_label", "yontem": "turulmus", "formul": "adresin_ilk_kismi", "aciklama": "Adresin ilk virgül öncesi kısmı" }
        ],
        "varsayilanlar": [
          { "alan": "show_directions_link", "deger": true, "aciklama": "Adres varsa yol tarifi butonu açık" }
        ],
        "tetiklenenler": ["gps_koordinat_talep"]
      }
    },
    {
      "sira": 4,
      "id": "calisma_saatleri",
      "soru": "Çalışma saatleriniz nedir?",
      "aciklama": "Hangi günler saat kaçta açıp kapattığınız. Serbest metin yeterli.",
      "girdi_tipi": "metin",
      "yerTutucu": "Ör: Hafta içi 09:00-18:00, Cumartesi 10:00-16:00",
      "ciktilar": {
        "dogrudan": [
          { "alan": "working_hours", "kaynak": "kullanici", "donusum": "trim" }
        ],
        "analiz": [
          { "alan": "working_hours_parsed", "yontem": "saat_ayrisma", "aciklama": "Regex ile saat/gün bilgisi ayrıştırılır, booking_settings.working_hours JSON'una yazılabilir", "opsiyonel": true }
        ]
      }
    },
    {
      "sira": 5,
      "id": "kisa_tanitim",
      "soru": "İşletmenizi 1-2 cümleyle tanıtın",
      "aciklama": "Hero bölümünde görünecek kısa açıklama.",
      "girdi_tipi": "uzunMetin",
      "yerTutucu": "Ör: 12 yıllık tecrübeyle Kadıköy'de hizmetinizdeyiz.",
      "ciktilar": {
        "dogrudan": [
          { "alan": "description", "kaynak": "kullanici", "donusum": "trim", "max": 300 }
        ]
      }
    },
    {
      "sira": 6,
      "id": "hakkimda_yazisi",
      "soru": "Hakkınızda birkaç cümle yazın (isteğe bağlı)",
      "aciklama": "Müşterilerinizin sizi tanıması için kısa bir hikaye. Boş geçilebilir ama vitrin kalitesini artırır.",
      "girdi_tipi": "uzunMetin",
      "yerTutucu": "Ör: 2014'ten beri Kadıköy'de kadın kuaförü olarak hizmet veriyoruz...",
      "atlanabilir": true,
      "ciktilar": {
        "dogrudan": [
          { "alan": "corporate_bio", "kaynak": "kullanici", "donusum": "trim", "max": 1200 }
        ]
      }
    },
    {
      "sira": 7,
      "id": "hizmetler_fiyatlar",
      "soru": "Hizmetlerinizi ve fiyatlarınızı yazın",
      "aciklama": "Her satırda bir hizmet: 'Saç Kesimi 150₺' gibi. Birden fazla satır yazılabilir.",
      "girdi_tipi": " Liste (çoklu satır)",
      "yerTutucu": "Saç Kesimi 150₺\nSaç Boyama 300₺\nKeratin Bakımı 500₺",
      "atlanabilir": true,
      "ciktilar": {
        "dogrudan": [
          { "alan": "offerings", "kaynak": "kullanici", "yontem": "hizmet_listesi_ayrisma", "aciklama": "Her satırı offering objesine dönüştür: {title, description, price}" }
        ],
        "varsayilanlar": [
          { "alan": "product_section_title", "deger_from_kategori": "sectionTitle", "aciklama": "Kural paketinden gelir, burada USER overrid edebilir" }
        ]
      }
    },
    {
      "sira": 8,
      "id": "sss_sorulari",
      "soru": "Sıkça sorulan sorularınız var mı?",
      "aciklama": "Her satırda bir soru-cevap. Boş geçilebilir.",
      "girdi_tipi": "liste_soru_cevap",
      "yerTutucu": "Randevu nasıl alınır? → WhatsApp'tan mesaj atın\nÖdeme yöntemleri nelerdir? → Nakit ve kredi kartı",
      "atlanabilir": true,
      "ciktilar": {
        "dogrudan": [
          { "alan": "faq_items", "kaynak": "kullanici", "yontem": "sss_ayrisma", "aciklama": "Her soru-cevap çiftini faq_items JSON array'ine dönüştür" }
        ]
      }
    },
    {
      "sira": 9,
      "id": "instagram_website",
      "soru": "Instagram veya web siteniz var mı?",
      "aciklama": "İkisi de opsiyonel. Varsa girilir, yoksa atlanır.",
      "girdi_tipi": "metin_plus_url",
      "yerTutucu": "@modasac veya modasac.com",
      "atlanabilir": true,
      "ciktilar": {
        "analiz": [
          { "alan": "instagram", "yontem": "instagram_tespit", "aciklama": "@ ile başlıyorsa instagram, değilse website olarak ayrıştır" },
          { "alan": "website", "yontem": "url_tespit", "aciklama": "http/https ile başlıyorsa website olarak ayrıştır" }
        ]
      }
    },
    {
      "sira": 10,
      "id": "logo_foto",
      "soru": "Logo veya fotoğraf yüklemek ister misiniz?",
      "aciklama": "Şu an için template görsel kullanılır. Gerçek fotoğraf eklenirse kalite artar.",
      "girdi_tipi": "gorsel_secim",
      "atlanabilir": true,
      "ciktilar": {
        "not": "apply_category_template zaten kapak/logo/galeri doldurdu. Bu adım real fotoğraf ile overrid etme imkanı tanır."
      }
    }
  ],

